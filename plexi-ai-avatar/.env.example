# ---- voice provider ---------------------------------------------------------
# llm        = browser speech recognition + LLM via /api/chat + browser TTS (default)
# elevenlabs = ElevenLabs Conversational AI agent (code kept; set the ELEVENLABS vars below)
VITE_VOICE_PROVIDER=llm

# ---- llm provider (server-side only, never VITE_) - any OpenAI-compatible chat API ----
# Google Gemini (FREE tier, no card; same key also does TTS below): https://aistudio.google.com -> Get API key
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai   LLM_MODEL=gemini-3.5-flash-lite (2 s replies; gemini-3.8-flash is smarter but ~5 s)
# Groq (free):      https://api.groq.com/openai/v1   LLM_MODEL=llama-3.3-70b-versatile
# Kimi (Moonshot):  https://api.moonshot.ai/v1       LLM_MODEL=kimi-k2.6
# Grok (xAI):       https://api.x.ai/v1              LLM_MODEL=grok-4.3
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
# LLM_PROVIDER=mock   -> canned offline replies for testing without a key

# ---- text to speech (server-side) ----
# elevenlabs = FREE plan ~10k credits/month, ~0.7 s, exact lip-sync timestamps (premade voices only on the free plan)
# gemini     = free but only 10 requests/day and ~5-9 s per clip  |  openai = any /audio/speech  |  browser = no key
TTS_PROVIDER=elevenlabs
TTS_MODEL=eleven_flash_v2_5
TTS_VOICE=cjVigY5qzO86Huf0OWal     # "Eric" (premade, male). Other premade male ids: JBFqnCBsd6RMkjVDRZzb George, nPczCjzI2devNBz1zQrb Brian, onwK4e9ZLuTAKqWW03F9 Daniel
TTS_API_KEY=                        # leave empty to reuse ELEVENLABS_API_KEY (needs the Text to Speech permission)
# Gemini voice instead: TTS_PROVIDER=gemini  TTS_MODEL=gemini-3.8-flash-tts  TTS_VOICE=Achird
# TTS_BASE_URL=        (openai-compatible providers only, e.g. https://api.groq.com/openai/v1)

# optional: speech-recognition language (en-IN, hi-IN ...) and an exact speechSynthesis voice name
VITE_STT_LANG=en-IN
VITE_TTS_VOICE=

# ---- elevenlabs provider ----------------------------------------------------
VITE_ELEVENLABS_AGENT_ID=
# Server-side only. Lets the dev server / Pages function mint session credentials (needs the Conversational AI permission).
ELEVENLABS_API_KEY=
